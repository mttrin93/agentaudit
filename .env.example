# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so nothing
# here is ever a real value — every line below is a placeholder or a default.
#
# The scripts in `scripts/` call `load_dotenv()` and so read `.env`. The HTTP API
# does not: no module of `backend/api/` is an environment reader of its own, and a
# test asserts it. The one variable the API needs — the signing key — reaches it
# through `signing.signing_key()`, from the real environment. So a key that lives
# only in `.env` will start the scripts and leave `uvicorn backend.api.app:create_app
# --factory` refusing to boot. Export it in the shell you start the server from.

# --- the signing key -------------------------------------------------------------
# The private half, 32 raw bytes base64-encoded on one line, as `scripts.keygen`
# prints it once. Never committed: publishing this repository must not publish the
# ability to forge its reports. Generate a dev pair, writing the public half outside
# the repository, because `keygen` refuses to replace the committed one:
#
#   uv run python -m scripts.keygen --public /tmp/dev-signing.pub
#
# A report signed by a dev key verifies only against that dev public half — pass it
# to `scripts/verify.py --pubkey`. The factory refuses to boot without this variable
# rather than measuring a target and then having no document to hand over
# (ADR-0020).
AGENTAUDIT_SIGNING_KEY=

# --- the provider ----------------------------------------------------------------
OPENROUTER_API_KEY=
# Optional. Defaults to https://openrouter.ai/api/v1 when unset.
OPENROUTER_BASE_URL=

# --- the target ------------------------------------------------------------------
# The bearer token `scripts/probe_target.py --token` defaults to. A credential for
# someone else's endpoint, so it is theirs to issue and yours to keep out of a
# commit.
AGENTAUDIT_TARGET_TOKEN=

# --- the models ------------------------------------------------------------------
# Four separate settings, deliberately. The reference agents' model is what is being
# measured; the adjudicator's is the instrument measuring it; the attacker's is a
# third thing that decides nothing. Collapsing any two of them into one would report
# an instrument's agreement with itself. Each falls back to the default shown, so
# leaving these unset is a supported way to run.
#
# The server reads them too, and unset means something else there: `create_app`
# defaults to no model at all, so an undeclared adjudicator runs no judged family and
# an undeclared attacker is the deterministic stand-in — stated as *not declared* in
# every report rather than named. A model named here and unbuildable stops the boot.
AGENTAUDIT_REFERENCE_MODEL=openrouter:openai/gpt-4.1-nano
AGENTAUDIT_ADJUDICATOR_MODEL=openrouter:openai/gpt-4.1-mini
AGENTAUDIT_ATTACKER_MODEL=openrouter:openai/gpt-4.1-mini
# `scripts/swap.py` only: the model the library is re-run on. It has to differ from
# AGENTAUDIT_REFERENCE_MODEL, or the second run measures run-to-run variation rather
# than a swap.
AGENTAUDIT_SECOND_REFERENCE_MODEL=openrouter:openai/gpt-4o-mini

# --- what is deliberately absent -------------------------------------------------
# There is no price-per-call variable here, and adding one would not work. The cost
# figures are the caller's declaration in the `POST /runs` body and are refused when
# missing: the confirmation is the liability record, so the number in it has to be
# one somebody agreed to, not one this bench found in its own configuration
# (ADR-0007). `AGENTAUDIT_PRICE_PER_CALL` appears in this repository only inside the
# tests that prove it is ignored.
