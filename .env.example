# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so nothing
# here is ever a real value — every line below is a placeholder or a default.
#
# The scripts in `scripts/` call `load_dotenv()` and so read `.env`. The HTTP API
# does not: no module of `backend/api/` is an environment reader of its own, and a
# test asserts it. The one variable the API needs — the signing key — reaches it
# through `signing.signing_key()`, from the real environment. So a key that lives
# only in `.env` will start the scripts and leave `uvicorn backend.api.app:create_app
# --factory` refusing to boot. Export it in the shell you start the server from.

# --- the signing key -------------------------------------------------------------
# The private half, 32 raw bytes base64-encoded on one line, as `scripts.keygen`
# prints it once. Never committed: publishing this repository must not publish the
# ability to forge its reports. Generate a dev pair, writing the public half outside
# the repository, because `keygen` refuses to replace the committed one:
#
#   uv run python -m scripts.keygen --public /tmp/dev-signing.pub
#
# A report signed by a dev key verifies only against that dev public half — pass it
# to `scripts/verify.py --pubkey`. The factory refuses to boot without this variable
# rather than measuring a target and then having no document to hand over
# (ADR-0020).
AGENTAUDIT_SIGNING_KEY=

# --- the provider ----------------------------------------------------------------
OPENROUTER_API_KEY=
# Optional. Defaults to https://openrouter.ai/api/v1 when unset.
OPENROUTER_BASE_URL=

# --- the target ------------------------------------------------------------------
# The bearer token `scripts/probe_target.py --token` defaults to. A credential for
# someone else's endpoint, so it is theirs to issue and yours to keep out of a
# commit.
AGENTAUDIT_TARGET_TOKEN=

# --- the models ------------------------------------------------------------------
# Four separate settings, deliberately. The reference agents' model is what is being
# measured; the adjudicator's is the instrument measuring it; the attacker's is a
# third thing that decides nothing. Collapsing any two of them into one would report
# an instrument's agreement with itself. Each falls back to the default shown, so
# leaving these unset is a supported way to run.
#
# The server reads them too, and unset means something else there: `create_app`
# defaults to no model at all, so an undeclared adjudicator runs no judged family and
# an undeclared attacker is the deterministic stand-in — stated as *not declared* in
# every report rather than named. A model named here and unbuildable stops the boot.
#
# Three of the four name one model today, and that is not the collapse the paragraph
# above refuses: ADR-0083 §3 argues why, and the consequence here is that each still
# has to be set on its own line to move.
#
# The reference agents' model moved off `openrouter:openai/gpt-4.1-nano` on
# 2026-09-07. The decision and the six readings behind it are
# `docs/adr/0083-the-reference-model-must-resolve-its-own-middle.md`; what matters
# when you edit this line is that a reference model has to clear two bars, not one —
# it must run the *trivial* agent as built, and it must be able to carry out a request
# harder than the simplest form of the attack.
AGENTAUDIT_REFERENCE_MODEL=openrouter:openai/gpt-4.1-mini
AGENTAUDIT_ADJUDICATOR_MODEL=openrouter:openai/gpt-4.1-mini
AGENTAUDIT_ATTACKER_MODEL=openrouter:openai/gpt-4.1-mini
# The second model, read by the two things in this bench that measure a *pair*:
# `scripts/swap.py`, which re-runs the whole library on it, and `/pending-routes`,
# which measures a route the attacker found against the cross-model admission bar on
# both models in one action (ADR-0012, ADR-0105). It has to differ from
# AGENTAUDIT_REFERENCE_MODEL, or the second run measures run-to-run variation rather
# than a swap — which is why the reference model did not move onto this string when it
# moved off nano, and a test asserts the two committed defaults still differ.
# Undeclared, the swap falls back to its own default and a deployed bench decides no
# pending route at all: it says so on the screen that would offer the control, because
# a bar met on one model is not the bar.
AGENTAUDIT_SECOND_REFERENCE_MODEL=openrouter:openai/gpt-4o-mini

# --- how long the adaptive attacker may work ------------------------------------
# `T`, the cap on one episode. The declared default of 8 was sized for a gate run,
# where every extra turn is multiplied by six families and three reference agents; a
# run against one target pays for one target, so the operator whose endpoint it is may
# say how long an attacker works on it. The figure reaches the estimate, so what is
# confirmed is what the run is held to. Unset is the declared 8. A value that is not a
# positive whole number stops the boot rather than falling back to it.
AGENTAUDIT_TURNS_PER_EPISODE=8

# --- the trace sink --------------------------------------------------------------
# Where a run's spans go, and the switch that decides whether any are emitted at all.
# Absent is tracing off, and off is a bench that boots, runs and reports normally —
# ADR-0020's shape without its severity, because a signing key is what makes a report
# portable and a trace sink is a convenience (ADR-0026).
#
# A trace carries the shape of a run and never its content: ids, family, case,
# attempt, node, timings, calls per layer, verdict, retry count, error class, model
# identifiers, and the endpoint *hash*. No payload, no reply, no narrative, no target
# name, no url, no token. Any OTLP/HTTP endpoint works, including a collector you run
# yourself; LangSmith's is shown because that is the sink this bench declares while
# its only targets are its own reference agents.
AGENTAUDIT_TRACE_ENDPOINT=
# The credential for a hosted sink. A local collector wants none, and an unset
# variable sends no header rather than an empty one.
AGENTAUDIT_TRACE_API_KEY=
# Optional. Which project the sink files the trace under.
AGENTAUDIT_TRACE_PROJECT=agentaudit
# Optional. What goes in front of every attribute name on the way to the sink.
# LangSmith keeps a custom attribute only under `langsmith.metadata.*` and silently
# discards anything else, so that is the default: without it the trace arrives with
# its names, its nesting and its durations, and not one field of the allowlist. Set
# it *empty* for a collector you run yourself, which keeps what it is sent. This is
# the one variable here where blank is a value rather than an unset variable.
AGENTAUDIT_TRACE_ATTRIBUTE_PREFIX=langsmith.metadata.
# Optional. The fraction of runs traced, between 0 and 1, defaulting to all of them.
# Sampling is over the whole trace, so a sampled-out run emits nothing rather than a
# run with holes in it. The Article 12 record does not sample whatever this says.
AGENTAUDIT_TRACE_SAMPLE=1.0
#
# The tracing switches of the library this bench happens to depend on are turned
# *off* at startup and cannot be used to reach a sink — they activate a tracer that
# sends prompts and replies verbatim, which is the one emission ADR-0026 exists to
# prevent. Setting one of them in `.env` does nothing except produce a warning
# naming it.

# --- what is deliberately absent -------------------------------------------------
# There is no price-per-call variable here, and adding one would not work. The cost
# figures are the caller's declaration in the `POST /runs` body and are refused when
# missing: the confirmation is the liability record, so the number in it has to be
# one somebody agreed to, not one this bench found in its own configuration
# (ADR-0007). `AGENTAUDIT_PRICE_PER_CALL` appears in this repository only inside the
# tests that prove it is ignored.
