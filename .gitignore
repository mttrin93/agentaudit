# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# DeepEval writes its last run and its anonymous-telemetry id here. Neither is a
# result the bench reports: kappa is read out of the returned per-case results
# (backend/bench/goldset.py) and recorded in docs/validation.md.
.deepeval/
.deepeval-cache.json

# The precedent store: deterministic findings about somebody else's agent, kept
# durable across restarts (ADR-0019) and never committed (ADR-0008). A directory
# rather than a file name, so an export or an editor's swap file beside it cannot
# become the first finding about a real target this repository carries.
/precedent/

# The lease a gate run holds on a case library while it writes back to it
# (backend/bench/lease.py). One writer at a time, and the file names the holder so
# that a lease left behind by a killed run can be cleared by hand — it is a fact
# about one machine's running processes and never part of the library.
.gate-run.lease

# Node
node_modules/
